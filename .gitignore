# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# env & secrets - never committed (secrets-and-env golden rule #1)
.env
.env.*
!.env.example
*.pem
*.key

# logs & caches
*.log
__pycache__/
.cache/

# language build output
node_modules/
dist/
build/
target/
coverage/

# build output — the bundle is reproducible from source, never committed
# (site.config.yaml build.output: static -> _site/, edge -> _edge/)
_site/
_edge/
