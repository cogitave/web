  "themes": {
    "$description": "Theme overlays. Each entry re-points SEMANTIC aliases only - a theme never introduces a new primitive and never touches spacing, radii or type, so switching themes cannot move the layout. The transform (tools/lib/tokens.mjs) emits each theme under [data-theme=\"<name>\"] and, scoped to :root:not([data-theme]), inside the matching prefers-color-scheme query, so an explicit user choice always beats the OS setting. Contrast note: text on background is #f8fafc on #0a0a0f, about 18:1, comfortably past WCAG 2.2 AA (4.5:1) and AAA (7:1) for body text.",
    "dark": {
      "semantic.color.background": "{color.ink.900}",
      "semantic.color.surface": "{color.ink.800}",
      "semantic.color.surface-raised": "{color.ink.600}",
      "semantic.color.border": "{color.ink.500}",
      "semantic.color.border-strong": "{color.neutral.700}",
      "semantic.color.text": "{color.neutral.50}",
      "semantic.color.text-muted": "{color.neutral.400}",
      "semantic.color.text-inverse": "{color.ink.900}",
      "semantic.color.action-foreground": "{color.neutral.0}"
    }
